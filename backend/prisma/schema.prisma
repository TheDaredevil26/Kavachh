// Prisma Schema for Kavach — Multi-tenant Parametric Income Insurance Platform
// PRD Sections 4.3–4.4

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────── Tenant ──────────────────────

model Tenant {
  id                  String   @id @default(uuid()) @db.Uuid
  slug                String   @unique @db.VarChar(50)
  displayName         String   @map("display_name") @db.VarChar(100)
  premiumMultiplier   Decimal  @default(1.00) @map("premium_multiplier") @db.Decimal(4, 2)
  allowedAdminDomains String[] @map("allowed_admin_domains")
  oauthIssuer         String?  @map("oauth_issuer") @db.VarChar(255)
  oauthClientId       String?  @map("oauth_client_id") @db.VarChar(255)
  config              Json     @default("{}")
  isActive            Boolean  @default(true) @map("is_active")
  createdAt           DateTime @default(now()) @map("created_at")

  workers      Worker[]
  policies     Policy[]
  claims       Claim[]
  payouts      Payout[]
  darkStores   DarkStore[]
  adminUsers   AdminUser[]
  triggerEvents TriggerEvent[]
  notificationLogs NotificationLog[]

  @@map("tenants")
}

// ────────────────────── Admin User ──────────────────────

model AdminUser {
  id          String    @id @default(uuid()) @db.Uuid
  tenantId    String?   @map("tenant_id") @db.Uuid
  email       String    @unique @db.VarChar(255)
  role        String    @db.VarChar(20)
  lastLoginAt DateTime? @map("last_login_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@map("admin_users")
}

// ────────────────────── Dark Store ──────────────────────

model DarkStore {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  zoneId    String   @map("zone_id") @db.VarChar(50)
  name      String   @db.VarChar(255)
  latitude  Decimal  @db.Decimal(10, 8)
  longitude Decimal  @db.Decimal(11, 8)
  qrSecret  String   @map("qr_secret") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, zoneId])
  @@map("dark_stores")
}

// ────────────────────── Worker ──────────────────────

model Worker {
  id                            String    @id @default(uuid()) @db.Uuid
  tenantId                      String    @map("tenant_id") @db.Uuid
  name                          String    @db.VarChar(255)
  phoneNumber                   String    @unique @map("phone_number") @db.VarChar(20)
  email                         String?   @unique @db.VarChar(255)
  dateOfBirth                   DateTime? @map("date_of_birth") @db.Date

  platformWorkerId              String    @map("platform_worker_id") @db.VarChar(100)
  platformOauthSubject          String?   @map("platform_oauth_subject") @db.VarChar(255)
  platformVerifiedAt            DateTime? @map("platform_verified_at")

  aadhaarNumber                 String?   @map("aadhaar_number") @db.VarChar(255)
  panNumber                     String?   @map("pan_number") @db.VarChar(255)
  kycVerified                   Boolean   @default(false) @map("kyc_verified")
  kycVerifiedAt                 DateTime? @map("kyc_verified_at")

  zoneId                        String    @map("zone_id") @db.VarChar(50)
  currentCity                   String?   @map("current_city") @db.VarChar(100)
  state                         String?   @db.VarChar(100)

  bankAccountNumber             String?   @map("bank_account_number") @db.VarChar(255)
  bankIfscCode                  String?   @map("bank_ifsc_code") @db.VarChar(100)
  accountHolderName             String?   @map("account_holder_name") @db.VarChar(255)
  bankVerificationStatus        String    @default("pending") @map("bank_verification_status") @db.VarChar(20)

  passwordHash                  String    @map("password_hash") @db.VarChar(255)
  lastLoginAt                   DateTime? @map("last_login_at")

  status                        String    @default("active") @db.VarChar(20)
  createdAt                     DateTime  @default(now()) @map("created_at")
  updatedAt                     DateTime  @default(now()) @updatedAt @map("updated_at")
  lastActiveAt                  DateTime? @map("last_active_at")

  registrationIpAddress         String?   @map("registration_ip_address")
  registrationDeviceFingerprint String?   @map("registration_device_fingerprint") @db.VarChar(255)

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  policies Policy[]
  claims   Claim[]
  payouts  Payout[]

  @@unique([tenantId, platformWorkerId])
  @@index([tenantId, zoneId])
  @@index([phoneNumber])
  @@index([createdAt(sort: Desc)])
  @@index([registrationIpAddress])
  @@index([registrationDeviceFingerprint])
  @@map("workers")
}

// ────────────────────── Policy ──────────────────────

model Policy {
  id                   String   @id @default(uuid()) @db.Uuid
  tenantId             String   @map("tenant_id") @db.Uuid
  workerId             String   @map("worker_id") @db.Uuid
  tier                 Int
  premiumWeekly        Decimal  @map("premium_weekly") @db.Decimal(8, 2)
  maxPayoutPerEvent    Decimal  @map("max_payout_per_event") @db.Decimal(10, 2)
  maxPayoutsPerMonth   Int      @map("max_payouts_per_month")
  coverageCeiling      Decimal  @map("coverage_ceiling") @db.Decimal(10, 2)
  triggerDayLimit      Int      @map("trigger_day_limit")
  coveragePercentage   Decimal  @default(100.00) @map("coverage_percentage") @db.Decimal(5, 2)
  reservedAmount       Decimal  @default(0) @map("reserved_amount") @db.Decimal(10, 2)
  settledAmount        Decimal  @default(0) @map("settled_amount") @db.Decimal(10, 2)
  startDate            DateTime @map("start_date") @db.Date
  endDate              DateTime @map("end_date") @db.Date
  isActive             Boolean  @default(true) @map("is_active")
  autoRenew            Boolean  @default(true) @map("auto_renew")
  status               String   @default("active") @db.VarChar(20)
  cancellationReason   String?  @map("cancellation_reason") @db.VarChar(255)
  cancelledAt          DateTime? @map("cancelled_at")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  worker    Worker           @relation(fields: [workerId], references: [id], onDelete: Cascade)
  coverages PolicyCoverage[]
  claims    Claim[]

  @@index([tenantId, workerId, isActive])
  @@index([endDate])
  @@index([status])
  @@map("policies")
}

// ────────────────────── Policy Coverage ──────────────────────

model PolicyCoverage {
  id                    String   @id @default(uuid()) @db.Uuid
  policyId              String   @map("policy_id") @db.Uuid
  triggerType           String   @map("trigger_type") @db.VarChar(50)
  isCovered             Boolean  @default(true) @map("is_covered")
  coveragePercentage    Decimal  @default(100.00) @map("coverage_percentage") @db.Decimal(5, 2)
  thresholdValue        Decimal? @map("threshold_value") @db.Decimal(10, 2)
  minimumDurationMinutes Int?    @map("minimum_duration_minutes")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId])
  @@map("policy_coverage")
}

// ────────────────────── Trigger Event ──────────────────────

model TriggerEvent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String?   @map("tenant_id") @db.Uuid
  triggerType     String    @map("trigger_type") @db.VarChar(50)
  zoneId          String    @map("zone_id") @db.VarChar(50)
  severity        String?   @db.VarChar(20)
  thresholdValue  Decimal?  @map("threshold_value") @db.Decimal(10, 2)
  actualValue     Decimal?  @map("actual_value") @db.Decimal(10, 2)
  detectedAt      DateTime  @default(now()) @map("detected_at")
  announcedAt     DateTime? @map("announced_at")
  startedAt       DateTime? @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationMinutes Int?      @map("duration_minutes")
  status          String    @default("active") @db.VarChar(20)
  dataSource      String?   @map("data_source") @db.VarChar(50)
  rawData         Json?     @map("raw_data")
  confirmedAt     DateTime? @map("confirmed_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  claims Claim[]

  @@index([zoneId])
  @@index([detectedAt(sort: Desc)])
  @@index([status])
  @@index([triggerType])
  @@map("trigger_events")
}

// ────────────────────── Claim ──────────────────────

model Claim {
  id                    String    @id @default(uuid()) @db.Uuid
  tenantId              String    @map("tenant_id") @db.Uuid
  workerId              String    @map("worker_id") @db.Uuid
  policyId              String    @map("policy_id") @db.Uuid
  triggerEventId        String    @map("trigger_event_id") @db.Uuid
  confidenceScore       Decimal?  @map("confidence_score") @db.Decimal(3, 2)
  fraudProbability      Decimal?  @map("fraud_probability") @db.Decimal(3, 2)
  isFlaggedForReview    Boolean   @default(false) @map("is_flagged_for_review")
  requestedAmount       Decimal?  @map("requested_amount") @db.Decimal(10, 2)
  approvedAmount        Decimal?  @map("approved_amount") @db.Decimal(10, 2)
  payoutAmount          Decimal?  @map("payout_amount") @db.Decimal(10, 2)
  payoutPercentage      Decimal?  @map("payout_percentage") @db.Decimal(5, 2)
  status                String    @default("filed") @db.VarChar(20)
  stateVersion          Int       @default(0) @map("state_version")
  disputeWindowEndsAt   DateTime? @map("dispute_window_ends_at")
  closedAt              DateTime? @map("closed_at")
  payoutId              String?   @map("payout_id") @db.Uuid
  payoutStatus          String?   @map("payout_status") @db.VarChar(20)
  payoutInitiatedAt     DateTime? @map("payout_initiated_at")
  payoutCompletedAt     DateTime? @map("payout_completed_at")
  reviewedBy            String?   @map("reviewed_by") @db.VarChar(255)
  reviewNotes           String?   @map("review_notes") @db.VarChar(1000)
  reviewedAt            DateTime? @map("reviewed_at")
  holdReason            String?   @map("hold_reason") @db.VarChar(500)
  heldUntil             DateTime? @map("held_until")
  reviewPriority        Int       @default(0) @map("review_priority")
  idempotencyKey        String    @unique @map("idempotency_key") @db.VarChar(255)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  worker        Worker              @relation(fields: [workerId], references: [id], onDelete: Cascade)
  policy        Policy              @relation(fields: [policyId], references: [id], onDelete: Cascade)
  triggerEvent  TriggerEvent        @relation(fields: [triggerEventId], references: [id], onDelete: Cascade)
  transitions   ClaimStateTransition[]
  disputes      ClaimDispute[]
  fraudSignals  FraudSignal[]
  payout        Payout?

  @@unique([workerId, triggerEventId])
  @@index([tenantId, workerId])
  @@index([tenantId, status, createdAt(sort: Desc)])
  @@index([triggerEventId])
  @@index([payoutStatus])
  @@map("claims")
}

// ────────────────────── Claim State Transition ──────────────────────

model ClaimStateTransition {
  id        Int      @id @default(autoincrement())
  claimId   String   @map("claim_id") @db.Uuid
  fromState String?  @map("from_state") @db.VarChar(20)
  toState   String   @map("to_state") @db.VarChar(20)
  actor     String   @db.VarChar(100)
  reason    String?  @db.VarChar(500)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
  @@map("claim_state_transitions")
}

// ────────────────────── Claim Dispute ──────────────────────

model ClaimDispute {
  id              String    @id @default(uuid()) @db.Uuid
  claimId         String    @map("claim_id") @db.Uuid
  workerId        String    @map("worker_id") @db.Uuid
  reason          String    @db.VarChar(1000)
  status          String    @default("open") @db.VarChar(20)
  resolutionNotes String?   @map("resolution_notes") @db.VarChar(1000)
  resolvedBy      String?   @map("resolved_by") @db.VarChar(255)
  openedAt        DateTime  @default(now()) @map("opened_at")
  resolvedAt      DateTime? @map("resolved_at")

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@map("claim_disputes")
}

// ────────────────────── Fraud Signal ──────────────────────

model FraudSignal {
  id          String   @id @default(uuid()) @db.Uuid
  claimId     String   @map("claim_id") @db.Uuid
  signalType  String   @map("signal_type") @db.VarChar(50)
  isSuspicious Boolean? @map("is_suspicious")
  score       Decimal? @db.Decimal(3, 2)
  details     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  claim Claim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId])
  @@index([signalType])
  @@map("fraud_signals")
}

// ────────────────────── Payout ──────────────────────

model Payout {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  claimId             String    @unique @map("claim_id") @db.Uuid
  workerId            String    @map("worker_id") @db.Uuid
  amount              Decimal   @db.Decimal(10, 2)
  idempotencyKey      String    @unique @map("idempotency_key") @db.VarChar(255)
  status              String    @default("pending") @db.VarChar(20)
  bankReferenceNumber String?   @map("bank_reference_number") @db.VarChar(100)
  initiatedAt         DateTime? @map("initiated_at")
  completedAt         DateTime? @map("completed_at")
  failureReason       String?   @map("failure_reason") @db.VarChar(500)
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  claim  Claim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@index([workerId])
  @@index([status])
  @@map("payouts")
}

// ────────────────────── Notification Log ──────────────────────

model NotificationLog {
  id               String    @id @default(uuid()) @db.Uuid
  tenantId         String?   @map("tenant_id") @db.Uuid
  workerId         String    @map("worker_id") @db.Uuid
  notificationType String    @map("notification_type") @db.VarChar(50)
  channel          String    @db.VarChar(20)
  title            String?   @db.VarChar(255)
  body             String?
  sentAt           DateTime  @default(now()) @map("sent_at")
  status           String    @default("sent") @db.VarChar(20)
  metadata         Json?

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([workerId, sentAt(sort: Desc)])
  @@map("notification_log")
}
