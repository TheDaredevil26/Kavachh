# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/kavach
MONGO_URL=mongodb://localhost:27017/kavach

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Auth / JWT ────────────────────────────────────────────
JWT_SECRET=your-64-char-hex-secret-here
JWT_ACCESS_EXPIRY=15m
REFRESH_TTL_DAYS=7

# ── Encryption ────────────────────────────────────────────
ENCRYPTION_KEY=your-64-char-hex-key-here

# ── Google OIDC ───────────────────────────────────────────
GOOGLE_OIDC_CLIENT_ID=your-google-client-id
GOOGLE_OIDC_CLIENT_SECRET=your-google-client-secret
OAUTH_REDIRECT_BASE=http://localhost:8000

# ── Mock Platform OAuth ──────────────────────────────────
MOCK_PLATFORM_OAUTH_URL=http://localhost:9000/oauth

# ── OpenWeatherMap ────────────────────────────────────────
OWM_API_KEY=your-owm-api-key

# ── ML Service ────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:5000

# ── App ───────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=8000
